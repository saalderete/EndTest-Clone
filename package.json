{
  "name": "testharvest",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development RUN_WORKER=${RUN_WORKER:-true} tsx server/index.ts",
    "worker": "tsx server/worker-main.ts",
    "build": "vite build && esbuild server/index.ts server/worker-main.ts server/scripts/migrate.ts server/scripts/admin.ts --platform=node --packages=external --bundle --format=esm --outdir=dist --out-extension:.js=.js --outbase=server",
    "start": "NODE_ENV=production node dist/index.js",
    "start:worker": "NODE_ENV=production node dist/worker-main.js",
    "db:migrate": "tsx server/scripts/migrate.ts",
    "admin": "tsx server/scripts/admin.ts",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:api": "vitest run tests/api",
    "test:e2e": "vitest run tests/e2e",
    "sample-app": "tsx sample-app/server.ts"
  },
