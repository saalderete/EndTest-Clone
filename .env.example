# TestHarvest configuration. Copy to .env and fill in. Never commit .env.

# ---- required ----
# Postgres connection. docker-compose builds this from POSTGRES_PASSWORD instead.
DATABASE_URL=postgres://testharvest:change-me@localhost:5432/testharvest
POSTGRES_PASSWORD=change-me
# Public address of the app, used in emails and invitation links.
APP_URL=http://localhost:5000
# At least 32 random characters. `openssl rand -base64 48`
SESSION_SECRET=
# 32 random bytes, base64. Encrypts workspace secrets; losing it makes them unreadable.
# `openssl rand -base64 32` prints one.
APP_ENCRYPTION_KEY=

# ---- web ----
PORT=5000
# Set when running behind a reverse proxy that terminates TLS.
TRUST_PROXY=false
# Let anyone create an account and workspace. Off: people join by invitation.
ALLOW_SIGNUP=false

# ---- worker ----
# The web process can also run the worker (handy for one small server).
RUN_WORKER=false
RUN_SCHEDULER=true
WORKER_CONCURRENCY=2
WORKSPACE_MAX_CONCURRENCY=2
TRACE_ON_FAILURE=true
ARTIFACT_DIR=./data/artifacts
ARTIFACT_RETENTION_DAYS=30
# Lets tests reach localhost and private networks. Leave off on shared servers.
ALLOW_PRIVATE_NETWORK=false
# "Run JavaScript" steps. Leave off unless every editor is trusted.
ALLOW_SCRIPT_STEPS=false
# CHROMIUM_PATH=/path/to/chromium

# ---- notifications (nothing is sent unless this is true) ----
NOTIFICATIONS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---- AI assistance (optional; each workspace must also turn it on) ----
AI_ENABLED=false
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

LOG_LEVEL=info
